{
  "description": "Automação e produtividade para as telas de Lançamento Automático e LOEC Suspensa do SRO Web.",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "lint": "prettier --check \".github/**\" \"src/**\" \"wxt.config.ts\" \"README.md\" \"blocklist.json\"",
    "format": "prettier --write \".github/**\" \"src/**\" \"wxt.config.ts\" \"README.md\" \"blocklist.json\"",
    "dev:chrome": "wxt -b chrome",
    "dev:edge": "wxt -b edge",
    "dev:firefox": "wxt -b firefox",
    "build": "pnpm build:chrome && pnpm build:edge && pnpm build:firefox",
    "build:chrome": "wxt build -b chrome",
    "build:edge": "wxt build -b edge",
    "build:firefox": "wxt build -b firefox",
    "zip": "pnpm zip:chrome && pnpm zip:edge && pnpm zip:firefox",
    "zip:chrome": "wxt zip -b chrome",
    "zip:edge": "wxt zip -b edge",
    "zip:firefox": "wxt zip -b firefox",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@wxt-dev/module-vue": "^1.0.3",
    "prettier": "^3.9.6",
    "terser": "^5.49.2",
    "typescript": "^7.0.2",
    "wxt": "^0.21.3"
  }
}
