{
  "manifest_version": 3,
  "name": "SRO Web - Indução",
  "version": "3.1.2",
  "description": "Ferramenta operacional para melhorar a experiência de indução no SRO Web.",
  "author": "Henrique Moreira",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://sroweb.correios.com.br/app/entregaexternaautomatica/lancamentoautomatico/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["https://sroweb.correios.com.br/*"]
    }
  ],
  "host_permissions": ["https://sroweb.correios.com.br/*"]
}
