{
  "manifest_version": 3,
  "name": "Correios Wizard",
  "version": "0.0.0.0",
  "description": "Conjunto de ferramentas internas para otimizar tarefas operacionais nos Correios",
  "author": "Henrique Moreira",
  "homepage_url": "https://github.com/henrique-coder/correios-wizard",
  "icons": {
    "16": "icons/16x16.png",
    "32": "icons/32x32.png",
    "48": "icons/48x48.png",
    "128": "icons/128x128.png"
  },
  "permissions": [],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/16x16.png",
      "32": "icons/32x32.png",
      "48": "icons/48x48.png"
    },
    "default_title": "Correios Wizard"
  },
  "content_scripts": [
    {
      "matches": [
        "https://sroweb.correios.com.br/app/entregaexternaautomatica/lancamentoautomatico/*",
        "https://sroweb.correios.com.br/app/entregaexternaautomatica/loecsuspensa/*"
      ],
      "js": ["browser-polyfill.min.js", "content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["https://sroweb.correios.com.br/*"]
    }
  ],
  "host_permissions": ["https://sroweb.correios.com.br/*"],
  "minimum_chrome_version": "102",
  "browser_specific_settings": {
    "gecko": {
      "id": "correios-wizard@henriquecoder.com",
      "strict_min_version": "121.0"
    }
  }
}
