{
  "projectCode": "CORREIOS_WIZARD",
  "actions": {
    "fetchProxy": "FETCH_PROXY"
  },
  "events": {
    "fetchReq": "_CW_FETCH_REQ_",
    "fetchRes": "_CW_FETCH_RES_"
  },
  "limits": {
    "fetchTimeoutMs": 10000,
    "remoteStatusTimeoutMs": 3500,
    "remoteStatusCacheTtlMs": 300000
  },
  "urls": {
    "srowebOrigin": "https://sroweb.correios.com.br",
    "srointranetOrigin": "https://srointranet.correios.com.br",
    "sromonitorOrigin": "https://sromonitor.correios.com.br",
    "srowebIndex": "https://sroweb.correios.com.br/app/index.php",
    "remoteStatus": "https://raw.githubusercontent.com/henrique-coder/correios-wizard/refs/heads/prod/status.json"
  },
  "security": {
    "allowedProxyHosts": [
      "sroweb.correios.com.br",
      "srointranet.correios.com.br",
      "sromonitor.correios.com.br"
    ]
  }
}
